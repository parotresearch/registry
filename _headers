# Cloudflare Workers static-asset headers for the served registry.
# index.json changes on every merge, so it is only briefly cached; every other
# listing is content-addressed and effectively immutable.
/r/*
  Content-Type: application/json
  Cache-Control: public, max-age=31536000, immutable
/r/index.json
  ! Cache-Control
  Cache-Control: public, max-age=300

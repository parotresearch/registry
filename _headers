# Cloudflare Pages / Workers static-asset headers for the served registry.
# index.json changes on every merge, so it is only briefly cached; every other
# listing is content-addressed and effectively immutable.
/r/index.json
  Content-Type: application/json
  Cache-Control: public, max-age=300
/r/*
  Content-Type: application/json
  Cache-Control: public, max-age=31536000, immutable

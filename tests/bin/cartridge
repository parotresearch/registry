#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# ///
"""A stub `cartridge` reader for offline tests.

It ignores the file it is handed and prints a canned `info --json` document
that mimics the real reader's wrapper shape:

    {archive, card, case_mode, codec, flags, manifest, seal, shards, sizes, version}

validate.py reads `.card` (the Card 1.0 object) and `.seal.status` (the seal
state string) from it, so the card-compare path runs with no real reader
present. The real reader is configured in CI via CARTRIDGE_BIN.
"""

import json
import sys
from pathlib import Path

card = json.loads((Path(__file__).resolve().parent.parent / "fixtures" / "card.json").read_text())
# Args look like: info --json <file>. We only implement `info`.
if "info" not in sys.argv:
    sys.stderr.write("stub cartridge: only `info --json <file>` is implemented\n")
    sys.exit(2)
print(json.dumps({
    "archive": "cart",
    "card": card,
    "case_mode": "preserve",
    "codec": "default",
    "flags": [],
    "manifest": {"files": 1},
    "seal": {"status": "legacy"},
    "shards": 1,
    "sizes": {"orig_bytes": 5589889, "total_bytes": 2048},
    "version": 1,
}))
